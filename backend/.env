# Environment Configuration for CIT Energy System
PROJECT_NAME="CIT Coimbatore Energy Anomaly Detection System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cit_energy_db"
SQLITE_FALLBACK_URL="sqlite:///./cit_energy.db"
USE_SQLITE_FALLBACK=True

# CORS Settings (Frontend URLs)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Anomaly Thresholds (Fractional deviation: 0.25 = 25%, 0.50 = 50%)
ANOMALY_WARNING_THRESHOLD=0.25
ANOMALY_CRITICAL_THRESHOLD=0.50

# ML Artifacts Directory
MODEL_DIR="./ml/saved_models"
DATA_DIR="./ml/data"

